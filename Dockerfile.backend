# FastAPI backend (main.py) for the React site. Render: Docker service,
# Dockerfile path = Dockerfile.backend.

# ---- 1. Small fix for Debian's XFOIL build ----
# Debian compiles XFOIL with floating-point traps on, so it crashes
# (SIGFPE) on a harmless divide-by-zero when graphics are switched off.
# This one-function library turns the traps off when preloaded.
FROM python:3.11-slim AS nofpe
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev \
    && printf 'void _gfortran_set_fpe(int v) { (void)v; }\n' > /nofpe.c \
    && gcc -shared -fPIC -O2 -o /nofpe.so /nofpe.c

# ---- 2. Backend ----
FROM python:3.11-slim

WORKDIR /app

# XFOIL 6.99 from Debian. Every XFOIL run uses PLOP G (graphics off), so no
# X display / Xvfb is needed.
RUN apt-get update && apt-get install -y --no-install-recommends xfoil \
    && rm -rf /var/lib/apt/lists/*

COPY --from=nofpe /nofpe.so /usr/local/lib/nofpe.so
RUN printf '#!/bin/sh\nLD_PRELOAD=/usr/local/lib/nofpe.so exec /usr/bin/xfoil "$@"\n' > /usr/local/bin/xfoil-run \
    && chmod +x /usr/local/bin/xfoil-run

ENV XFOIL_PATH=/usr/local/bin/xfoil-run \
    PYTHONUNBUFFERED=1

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# All Python modules in the repo: main.py, db_utils.py, inverse_design.py
# and the aeroelasticity solvers.
COPY *.py ./

EXPOSE 8000

# Render passes the port in $PORT.
CMD ["sh", "-c", "exec uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"]
