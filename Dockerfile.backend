# FastAPI backend (main.py). Render: Docker service,
# Dockerfile path = Dockerfile.backend.

# ---- 1. Build XFOIL 6.996 from source (third_party/xfoil) ----
# The same XFOIL version the website runs in the browser, so the server's
# results match. Built without graphics; every run uses PLOP G.
FROM python:3.11-slim AS xfoil
RUN apt-get update && apt-get install -y --no-install-recommends gfortran gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*
COPY third_party/xfoil /xfoil
RUN sh /xfoil/build.sh

# ---- 2. Backend ----
FROM python:3.11-slim

WORKDIR /app

# Fortran runtime for XFOIL
RUN apt-get update && apt-get install -y --no-install-recommends libgfortran5 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=xfoil /xfoil/xfoil /usr/local/bin/xfoil

ENV XFOIL_PATH=/usr/local/bin/xfoil \
    PYTHONUNBUFFERED=1

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# All Python modules in the repo: main.py, db_utils.py, inverse_design.py
# and the aeroelasticity solvers.
COPY *.py ./

EXPOSE 8000

# Render passes the port in $PORT.
CMD ["sh", "-c", "exec uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"]
