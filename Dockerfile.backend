# FastAPI backend (main.py) for the React site. Render: Docker service,
# Dockerfile path = Dockerfile.backend.
FROM python:3.11-slim

WORKDIR /app

# XFOIL (Debian package, v6.99) plus a virtual X server, since XFOIL
# expects a display even when plotting is switched off.
RUN apt-get update && apt-get install -y --no-install-recommends \
    xfoil \
    xvfb \
    x11-utils \
    && rm -rf /var/lib/apt/lists/*

ENV XFOIL_PATH=/usr/bin/xfoil \
    PYTHONUNBUFFERED=1

# Start Xvfb in the background, then the API. Render passes the port in $PORT.
RUN printf '#!/bin/bash\nXvfb :99 -screen 0 1024x768x24 &\nexport DISPLAY=:99\nsleep 1\nexec uvicorn main:app --host 0.0.0.0 --port "${PORT:-8000}"\n' > /start.sh \
    && chmod +x /start.sh

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# All Python modules in the repo: main.py, db_utils.py, inverse_design.py,
# and the aeroelasticity solvers whenever they are committed (without
# them those endpoints return 503).
COPY *.py ./

EXPOSE 8000

CMD ["/start.sh"]
