# React frontend (aerolab-web) served by nginx. Render: Docker web service,
# Dockerfile path = Dockerfile.frontend, build context = repo root.

# ---- 1. Build the site ----
FROM node:20-alpine AS build
WORKDIR /web

# Backend address baked into the build (Render passes env vars as build args)
ARG VITE_BACKEND_URL=https://aerolab-backend.onrender.com
ENV VITE_BACKEND_URL=$VITE_BACKEND_URL

COPY aerolab-web/package.json aerolab-web/package-lock.json ./
RUN npm ci
COPY aerolab-web/ ./
RUN npm run build

# ---- 2. Serve it ----
FROM nginx:1.27-alpine

# Render sets $PORT (10000 by default); nginx fills it into the template at
# startup. $uri is not an environment variable, so it is left as is.
ENV PORT=10000
RUN mkdir -p /etc/nginx/templates && printf '%s\n' \
  'server {' \
  '  listen ${PORT};' \
  '  root /usr/share/nginx/html;' \
  '  index index.html;' \
  '  gzip on;' \
  '  gzip_types text/css application/javascript application/json image/svg+xml text/plain;' \
  '  # Hashed build files never change, so browsers can cache them for a year' \
  '  location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; try_files $uri =404; }' \
  '  # Single-page app: any other path loads index.html and React Router picks the page' \
  '  location / { try_files $uri $uri/ /index.html; }' \
  '}' > /etc/nginx/templates/default.conf.template

COPY --from=build /web/dist /usr/share/nginx/html

EXPOSE 10000
